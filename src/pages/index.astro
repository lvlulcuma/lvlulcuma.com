---
// The bare domain. Cloudflare redirects "/" to "/en/" (see public/_redirects);
// this page is the fallback and also works as a language chooser.
import "../styles/global.css";
import SiteIcons from "../components/SiteIcons.astro";
import { HTML_LANG, LANGS, LANG_NAME, LANG_LABEL } from "../i18n/ui";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://lvlulcuma.com/en/" />
    <SiteIcons />
    <title>lvlulcuma.com</title>
  </head>
  <body>
    <main class="plain">
      <h1>lvlulcuma.com</h1>
      <ul>{LANGS.map((l) => <li><a href={`/${l}/`} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]}>{LANG_NAME[l]}<span>{LANG_LABEL[l]}</span></a></li>)}</ul>
    </main>
  </body>
</html>
