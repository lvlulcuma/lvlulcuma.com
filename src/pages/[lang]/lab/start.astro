---
// Get started: what a home lab needs and how to set one up safely, before picking an idea.
// Text: content/pages/lab-start/<lang>.md. The text below its second --- is the page; a line <!-- lab:<name> -->
// in it places one of the pictures from src/components/LabStartVisual.astro there, with the words from `visuals:`.
// A <!-- guide: a, b --> at the end of a paragraph or list item becomes a "Step by step" line with those guides,
// right where the page talks about that task (fillGuideRefs in src/lib/content.ts); cards do the same with `guide:`.
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import LabIdeaCard from "../../../components/LabIdeaCard.astro";
import LabStartVisual from "../../../components/LabStartVisual.astro";
import { langPaths, ui, type Lang } from "../../../i18n/ui";
import { fillGuideRefs, getPage } from "../../../lib/content";
import { toc } from "../../../lib/block";
import { getIdeas } from "../../../lib/lab";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const page = await getPage("lab-start", lang);
const { headings } = await render(page.entry);
const rules = (await getPage("lab-rules", lang)).data;
// Split the text at the picture lines: [text, name, text, name, text, …]. A picture line inside a list or a box
// would cut it in two, so they stand on their own line between paragraphs. The "Step by step" mentions in the text
// are filled in first.
const PICTURES = ["map", "plan", "ram", "check", "kinds", "pick", "systems", "nets", "snaps", "notebook", "weekend"];
const file = `content/pages/lab-start/${lang}.md`;
const parts = (await fillGuideRefs(page.entry.rendered?.html ?? "", lang, file)).split(/<!--\s*lab:([a-z]+)\s*-->/);
parts.forEach((p, i) => {
  if (i % 2 && !PICTURES.includes(p)) throw new Error(`${file}: there is no picture "lab:${p}". Pictures: ${PICTURES.join(", ")}.`);
});
// "Then try one of these": the easiest ideas first.
const LEVELS = ["beginner", "intermediate", "advanced"];
const first = (await getIdeas(lang)).slice().sort((a, b) => LEVELS.indexOf(a.entry.data.level) - LEVELS.indexOf(b.entry.data.level) || a.entry.data.time - b.entry.data.time).slice(0, 4);
---
<Base lang={lang} nav="lab" title={page.data.title} description={page.data.intro} block={{
    key: page.data.key,
    contents: toc(headings),
    go: { items: [
      { kicker: t.nav.lab, text: rules.title, href: `/${lang}/lab/rules/` },
      { kicker: t.nav.lab, text: t.labAllIdeas, href: `/${lang}/lab/` },
    ] },
    rows: [[t.updated, page.updated]],
    strip: [`${t.updated} ${page.updated}`],
  }}>
  <h1>{page.data.title}</h1>
  <p class="lede">{page.data.intro}</p>
  <div class="prose guide gs-page">
    {parts.map((p, i) => (i % 2 ? <LabStartVisual name={p} v={page.data.visuals ?? {}} headings={headings} lang={lang} /> : <Fragment set:html={p} />))}
  </div>

  {first.length > 0 && (
    <section class="gsec gnext" aria-labelledby="first-ideas">
      <div class="block-head">
        <h2 id="first-ideas">{t.labFirstIdeas}</h2>
        <a href={`/${lang}/lab/`}>{t.labAllIdeas}&nbsp;<span class="arr" aria-hidden="true"></span></a>
      </div>
      <ul class="gcards">{first.map((x) => <LabIdeaCard idea={x} lang={lang} label={t.labGroups[x.group]} />)}</ul>
    </section>
  )}
</Base>
