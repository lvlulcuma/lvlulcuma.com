---
// Rules of engagement. Text and list: content/pages/lab-rules/<lang>.md
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { langPaths, ui, type Lang } from "../../../i18n/ui";
import { getPage } from "../../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const page = await getPage("lab-rules", lang);
const { Content } = await render(page.entry);
const setup = (await getPage("lab-setup", lang)).data;
const ruleCount = ((page.entry.body ?? "").match(/^\s*\d+\.\s/gm) ?? []).length;
---
<Base lang={lang} nav="lab" title={page.data.title} description={page.data.intro} block={{
    key: { label: t.rules, value: String(ruleCount) },
    go: { items: [{ kicker: t.nav.lab, text: setup.title, href: `/${lang}/lab/setup/` }] },
    rows: [[t.updated, page.updated]],
    strip: [`${t.updated} ${page.updated}`],
  }}>
  <h1>{page.data.title}</h1>
  <p class="lede">{page.data.intro}</p>
  <div class="rules mt bt"><Content /></div>
</Base>
