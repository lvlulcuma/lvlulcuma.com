---
// Build your lab: a step-by-step guide. Text: content/pages/lab-setup/<lang>.md
// The file it walks through is public/lab/compose.yaml (served at /lab/compose.yaml); the page shows it with
// "#include public/lab/compose.yaml" (see src/lib/markdown.mjs), so the page and the download are always the same.
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Related from "../../../components/Related.astro";
import { langPaths, ui, type Lang } from "../../../i18n/ui";
import { getPage } from "../../../lib/content";
import { getArticles } from "../../../lib/articles";
import { toc } from "../../../lib/block";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const page = await getPage("lab-setup", lang);
const { Content, headings } = await render(page.entry);
const rules = (await getPage("lab-rules", lang)).data;
const article = page.data.related_article ? (await getArticles(lang)).find((n) => n.slug === page.data.related_article) : undefined;
---
<Base lang={lang} nav="lab" title={page.data.title} description={page.data.intro} block={{
    key: page.data.key,
    contents: toc(headings),
    go: { items: [
      { kicker: t.labFile, text: "compose.yaml", href: "/lab/compose.yaml" },
      { kicker: t.nav.lab, text: rules.title, href: `/${lang}/lab/rules/` },
      ...(article ? [{ kicker: `${t.related} · ${t.issue} ${article.issue}`, text: article.entry.data.title, href: `/${lang}/articles/${article.slug}/` }] : []),
    ] },
    rows: [[t.updated, page.updated]],
    strip: [`${t.updated} ${page.updated}`],
  }}>
  <h1>{page.data.title}</h1>
  <p class="lede">{page.data.intro}</p>
  <div class="prose guide"><Content /></div>
  {article && <Related label={t.related} href={`/${lang}/articles/${article.slug}/`} tag={`${t.issue} ${article.issue}`} title={article.entry.data.title} />}
</Base>
