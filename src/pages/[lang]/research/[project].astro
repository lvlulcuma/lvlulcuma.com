---
// One research project. Text: content/research/<project>/<lang>.md
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Related from "../../../components/Related.astro";
import { LANGS, ui, type Lang } from "../../../i18n/ui";
import { getPage, getProjects, type Project } from "../../../lib/content";
import { getArticles, iso } from "../../../lib/articles";
import { lastChange, stageList } from "../../../lib/block";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const p of await getProjects(lang)) {
      if (p.entry.data.page) paths.push({ params: { lang, project: p.slug }, props: { p } });
    }
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const { p } = Astro.props as { p: Project };
const d = p.entry.data;
const live = d.status === "in-progress";
const { Content } = await render(p.entry);
const hasBody = (p.entry.body ?? "").trim().length > 0;
const article = d.related_article ? (await getArticles(lang)).find((n) => n.slug === d.related_article) : undefined;
const stages = d.method ? stageList(d.method, d.current_step) : undefined;
const current = d.method && d.current_step ? d.method[d.current_step - 1]?.step : undefined;
---
<Base lang={lang} nav="research" title={d.title} description={d.summary} block={{
    key: live && d.method && d.current_step ? { label: t.stage, value: `${d.current_step} / ${d.method.length}` } : { label: t.status, value: live ? t.inprogress : t.planned },
    rows: [...(live && d.current_step ? [[t.status, t.inprogress] as [string, string]] : []), [t.published, iso(d.published)] as [string, string]],
    stages,
    go: { items: article ? [{ kicker: `${t.related} · ${t.issue} ${article.issue}`, text: article.entry.data.title, href: `/${lang}/articles/${article.slug}/` }] : [] },
    changed: lastChange(d.revisions),
    strip: current ? [current] : [],
  }}>
  <p class="kicker"><span class={live ? "pill live" : "pill"}>{live ? t.inprogress : t.planned}</span></p>
  <h1>{d.title}</h1>
  {d.question && (<><span class="label">{t.question}</span><p class="question">{d.question}</p></>)}
  {d.why && (<><span class="label">{t.why}</span><p>{d.why}</p></>)}
  {d.method && (
    <>
      <span class="label">{t.method}</span>
      <ol class="flow">
        {d.method.map((s, i) => <li><span class="mono">{i + 1}/{d.method!.length}</span><strong>{s.step}</strong><p>{s.text}</p></li>)}
      </ol>
    </>
  )}
  {d.sources && (<><span class="label">{t.sources}</span><div class="prose"><ul>{d.sources.map((s) => <li>{s}</li>)}</ul></div></>)}
  {d.status_note && (<><span class="label">{t.status}</span><p>{d.status_note}</p></>)}
  {hasBody && <div class="prose mt"><Content /></div>}
  {article && <Related label={t.related} href={`/${lang}/articles/${article.slug}/`} tag={`${t.issue} ${article.issue}`} title={article.entry.data.title} />}
</Base>
