---
import Base from "../../../layouts/Base.astro";
import ArticlesIndex from "../../../components/ArticlesIndex.astro";
import { langPaths, ui, type Lang } from "../../../i18n/ui";
import { getArticles, iso, nextIssueDate, topicFilter } from "../../../lib/articles";
import { getPage, getSettings } from "../../../lib/content";
import { countArticles } from "../../../lib/block";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const articles = await getArticles(lang);
const page = await getPage("articles", lang);
const medium = (await getSettings()).medium;
---
<Base printIn lang={lang} nav="articles" title={t.nav.articles} description={page.data.intro} block={{
    key: { label: t.published, value: countArticles(articles.length, lang, t) },
    filter: topicFilter(lang, articles),
    go: { items: [{ text: t.rssFollow, href: `/${lang}/rss.xml` }, ...(medium ? [{ text: t.mediumFollow, href: medium }] : [])], phone: false },
    rows: articles[0] ? [[t.upcoming, iso(nextIssueDate(articles[0].date))]] : [],
    strip: articles[0] ? [`${t.upcoming} ${iso(nextIssueDate(articles[0].date))}`] : [],
  }}>
  <ArticlesIndex lang={lang} />
</Base>
