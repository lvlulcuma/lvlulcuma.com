---
// The notice on a made-up example entry (`example: true`), and above lists that contain them.
// Text: `exampleNote` / `exampleListNote` in content/ui/<lang>.yml.
import { ui, type Lang } from "../i18n/ui";
interface Props { lang: Lang; list?: boolean }
const { lang, list = false } = Astro.props;
const t = ui[lang];
---
<div class="callout callout-warning example-note">
  <p class="callout-label">{t.example}</p>
  <p>{list ? t.exampleListNote : t.exampleNote}</p>
</div>
