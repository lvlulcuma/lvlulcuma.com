---
// A "Step by step" box: the detailed guides for one part of an overview page, for readers who want every click.
// A line <!-- guides: install-utm, check-hash --> on its own in the page's text places one (src/lib/content.ts,
// stepRows). It looks and behaves like "Before you start" on a guide: a framed box with a tab, one row per guide,
// the whole row a link. A guide that isn't written yet (content/guides/planned.yml) is a quiet row without a link,
// with "Coming soon" where the time would be. Guides are in English for now; on other languages' pages their
// titles are marked EN. The line under the tab ("Want every click?") shows only in a page's first box (`intro`).
import { HTML_LANG, LANG_LABEL, ui, type Lang } from "../i18n/ui";
import type { StepRow } from "../lib/content";
interface Props { rows: StepRow[]; lang: Lang; n: number; intro?: boolean }
const { rows, lang, n, intro = true } = Astro.props;
const t = ui[lang];
const id = `steps-${n}`;
---
<aside class="prereq steps" aria-labelledby={id}>
  <p class="prereq-h" id={id}>{t.stepByStep}</p>
  {intro && <p class="prereq-d">{t.stepByStepText}</p>}
  <ul>
    {rows.map((r) => {
      const other = r.lang !== lang;
      return r.href ? (
        <li><a href={r.href} hreflang={other ? HTML_LANG[r.lang] : undefined}><span class="t"><span lang={other ? HTML_LANG[r.lang] : undefined}>{r.title}</span>{other && <span class="gc-lang">{LANG_LABEL[r.lang]}</span>}</span><span class="m">{r.meta}&nbsp;<span class="arr" aria-hidden="true"></span></span></a></li>
      ) : (
        <li class="soon"><span class="row"><span class="t"><span lang={other ? HTML_LANG[r.lang] : undefined}>{r.title}</span>{other && <span class="gc-lang">{LANG_LABEL[r.lang]}</span>}</span><span class="m">{r.meta}</span></span></li>
      );
    })}
  </ul>
</aside>
