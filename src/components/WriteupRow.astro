---
// One forensics write-up in a list (the /forensics/ hub). Same look as an incident breakdown's row: the date, the title
// and one line, then where the case comes from (my own lab, or the challenge's platform), its level and its tools.
import { HTML_LANG, LANG_LABEL, ui, type Lang } from "../i18n/ui";
import { iso } from "../lib/articles";
import { writeupHref, type Writeup } from "../lib/forensics";
interface Props { writeup: Writeup; lang: Lang }
const { writeup: w, lang } = Astro.props;
const t = ui[lang];
const other = w.lang !== lang ? HTML_LANG[w.lang] : undefined;
const d = w.entry.data;
const TOOLS_SHOWN = 3;
---
<li>
  <a href={writeupHref(w)} hreflang={other}>
    <span class="date">{iso(w.date)}</span>
    <span class="t" lang={other}>{d.title}</span>
    <span class="d" lang={other}>{d.dek}</span>
    <span class="meta">
      <span class="tag">{d.challenge ? d.challenge.platform : t.writeupSources[d.source]}</span>
      <span class="pill">{t.labLevels[d.level]}</span>
      {d.tools.length > 0 && <span>{d.tools.slice(0, TOOLS_SHOWN).join(", ")}{d.tools.length > TOOLS_SHOWN ? ", …" : ""}</span>}
      {w.lang !== lang && <span class="gc-lang">{LANG_LABEL[w.lang]}</span>}
    </span>
  </a>
</li>
