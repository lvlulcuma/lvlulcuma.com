---
// One row of the "New this week" box (Announcements.astro): one section of the site and what's new in it, so the eye
// can run down the left edge and know at once where something was added. The section's name (as in the menu) and how
// many things changed in it on the first line; under it one short line saying what: the title when it's one thing,
// a summary when it's several ("Week 45 · 6 breakdowns", "What to learn for 9 jobs"). The whole row links to the
// one thing, or to the section when there are several.
import { HTML_LANG, type Lang } from "../i18n/ui";
import type { ChangeGroup } from "../lib/changes";

interface Props { g: ChangeGroup; lang: Lang }
const { g, lang } = Astro.props;
const other = g.lang && g.lang !== lang ? HTML_LANG[g.lang] : undefined;
const Tag = g.href ? "a" : "div";
---
<li>
  <Tag href={g.href} rel={g.href && /^https?:/.test(g.href) ? "noopener" : undefined}>
    <span class="ann-g"><span class="ann-sec">{g.label}</span><span class="ann-c">{g.count}</span></span>
    <span class="ann-t" lang={other}>{g.summary}</span>
  </Tag>
</li>
