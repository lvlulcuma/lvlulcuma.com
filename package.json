{
  "name": "lvlulcuma-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/redirect-hidden-langs.mjs && node scripts/drop-noindex-from-sitemap.mjs && node scripts/check-csp.mjs",
    "preview": "astro preview",
    "check:links": "node scripts/check-links.mjs dist",
    "build:all-langs": "node scripts/build-all-langs.mjs",
    "new-article": "node scripts/new-article.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
