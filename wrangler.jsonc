{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site served by Cloudflare Workers (static assets only, no server code).
  "name": "lvlulcuma",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  // Attach the site to your domain on deploy. The domain must be in the same Cloudflare account,
  // and the apex must not already have an A/AAAA/CNAME record pointing elsewhere.
  "routes": [
    { "pattern": "lvlulcuma.com", "custom_domain": true }
  ]
}
